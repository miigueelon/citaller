# Copia este fichero a .env.local (no se commitea) y rellena los valores.
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Solo para `npm run backup` (Supabase -> Project Settings -> Database -> Reset database password). Nunca en el repo.
SUPABASE_DB_PASSWORD=

# Taller de pruebas e2e (lo usa `npm run probar-cadena` y, desde la fase 2, Playwright)
E2E_TALLER_EMAIL=taller.e2e@citaller.test
E2E_TALLER_PASSWORD=

# Solo para `npm run e2e` contra un preview de Vercel (Vercel -> Settings -> Deployment Protection -> Protection Bypass for Automation)
E2E_BYPASS_SECRET=
